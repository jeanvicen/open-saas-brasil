generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model User { id String @id @default(cuid()) name String? email String? @unique cpf String? @unique passwordHash String? image String? emailVerified DateTime? accounts Account[] sessions Session[] clientes Cliente[] agendamentos Agendamento[] pagamentos Pagamento[] createdAt DateTime @default(now()) }
model Account { userId String type String provider String providerAccountId String refresh_token String? @db.Text access_token String? @db.Text expires_at Int? token_type String? scope String? id_token String? @db.Text session_state String? user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@id([provider,providerAccountId]) }
model Session { sessionToken String @unique userId String expires DateTime user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@id([sessionToken]) }
model VerificationToken { identifier String token String @unique expires DateTime @@unique([identifier,token]) }
model Cliente { id String @id @default(cuid()) userId String nome String telefone String? email String? observacoes String? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) agendamentos Agendamento[] @@index([userId, nome]) }
model Agendamento { id String @id @default(cuid()) userId String clienteId String? clienteNome String servico String dataHora DateTime valorCentavos Int status String @default("AGENDADO") createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) cliente Cliente? @relation(fields:[clienteId],references:[id],onDelete:SetNull) @@index([userId,dataHora]) }
model Pagamento { id String @id @default(cuid()) userId String valorCentavos Int descricao String payloadPix String status String @default("PENDENTE") criadoEm DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,criadoEm]) }